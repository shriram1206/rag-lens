# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file — it is git-ignored.

# Required: Groq API key for the judge LLM (Llama-3)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Only needed if you want to run the ada-002 embedding arm of the benchmark
# Without this key, 2/3 of the embedding matrix (BGE-large, E5-large) still works locally.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the default judge model (default: llama-3.1-70b-versatile)
# JUDGE_MODEL=llama-3.1-70b-versatile

# Optional: Cap concurrent judge calls (default: 5)
# JUDGE_CONCURRENCY=5
